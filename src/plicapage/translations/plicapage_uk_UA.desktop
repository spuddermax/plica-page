[Desktop Entry]
Exec=plicapage %U
Icon=plicapage
Terminal=false
Type=Application
StartupNotify=true
Categories=Qt;Office;
MimeType=application/x-plicapage-boo;application/x-boomaga-boo;

Name=PlicaPage
GenericName=Virtual printer
Comment=Virtual printer for viewing and editing a document before printing.



# Translations
Comment[uk_UA]=Віртуальний принтер, який дає змогу переглянути і відредагувати документ перед друком.
GenericName[uk_UA]=Віртуальний принтер
Name[uk_UA]=PlicaPage
Icon[uk_UA]=plicapage
