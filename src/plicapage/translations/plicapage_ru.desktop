[Desktop Entry]
Exec=plicapage %U
Icon=plicapage
Terminal=false
Type=Application
StartupNotify=true
Categories=Qt;Office;
MimeType=application/x-plicapage-boo;application/x-boomaga-boo;

Name=PlicaPage
GenericName=Virtual printer
Comment=Virtual printer for viewing and editing a document before printing.



# Translations
Comment[ru]=Виртуальный принтер, позволяет посмотреть и изменить документ перед печатью.
GenericName[ru]=Виртуальный принтер
Name[ru]=PlicaPage
