policy_module(plicapage, @FULL_VERSION@)

# Declarations
gen_require(`
  attribute cups_domain;
')
 
type plicapage_cups_t, cups_domain;
type plicapage_cups_exec_t;
cups_backend(plicapage_cups_t, plicapage_cups_exec_t)

permissive plicapage_cups_t;

gnome_manage_generic_cache_files(plicapage_cups_t)
gnome_read_home_config(plicapage_cups_t)
domain_read_all_domains_state(plicapage_cups_t)
auth_read_passwd(plicapage_cups_t)
kernel_read_system_state(plicapage_cups_t)
dbus_system_bus_client(plicapage_cups_t)
dbus_session_bus_client(plicapage_cups_t)

# required for access to /run/user/%{USERID}/bus socket
# which is labeld user_tmp_t and the user listens
# with unconfined_t.
# with newer dbus versions the label will change
# and there will maybe be something like
# unconfined_dbus_session_bus_client.
userdom_write_user_tmp_sockets(plicapage_cups_t)
unconfined_stream_connect(plicapage_cups_t)
